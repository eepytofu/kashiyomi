{
  "name": "kashiyomi",
  "version": "0.1.0",
  "private": true,
  "description": "BetterNCM plugin that adds local furigana, romaji, pinyin, and AI translation to the native lyrics page",
  "repository": "https://github.com/eepytofu/kashiyomi.git",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "watch": "node tools/build.mjs --watch",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "fetch-dict": "node tools/fetch-dictionaries.mjs"
  },
  "dependencies": {
    "@pinyin-pro/data": "1.3.1",
    "opencc-js": "^1.4.0",
    "pinyin-pro": "^3.28.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "esbuild": "^0.24.0",
    "typescript": "^5.9.3"
  }
}
