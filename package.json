{
  "name": "kashiyomi",
  "version": "0.1.0",
  "private": true,
  "description": "BetterNCM plugin that adds local furigana, romaji, pinyin, and AI translation to the native lyrics page",
  "repository": "https://github.com/eepytofu/kashiyomi.git",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "watch": "node tools/build.mjs --watch",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "mutate": "node tools/mutation/run.mjs tools/mutation/cjk-mutations.json && node tools/mutation/run.mjs tools/mutation/engine-mutations.json",
    "capture": "node tools/capture/lyrics.mjs",
    "fetch-dict": "node tools/fetch-dictionaries.mjs",
    "export-pinyin": "node tools/export-pinyin-dict.mjs",
    "dev-install": "node tools/dev-install.mjs",
    "export-jmdict": "node tools/export-jmdict-readings.mjs"
  },
  "dependencies": {
    "@pinyin-pro/data": "1.3.1",
    "opencc-js": "^1.4.0",
    "pinyin-pro": "^3.28.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2"
  }
}
